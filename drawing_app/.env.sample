OCTOPRINT_API_KEY=your_api_key_here

# 以下はオプション（未設定なら括弧内の既定値が使われる）

# Flaskサーバーのポート（既定: 5000）
# Raspberry Pi単体運用時はOctoPrintが同じPi上でポート5000(内部)/80(haproxy経由)を
# 使用しているため競合する。その場合は WEB_PORT=8080 のように上書きする。
# WEB_PORT=8080

# OctoPrintのURL（既定: http://3dz5.local）
# Raspberry Pi自身の上でこのアプリを動かす場合は、起動直後のmDNS自己解決に
# 依存しないよう http://localhost にするのを推奨。
# OCTOPRINT_URL=http://localhost
